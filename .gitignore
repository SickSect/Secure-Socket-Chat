# Compiled class file
*.class

# Log file
*.log
logs/
app/logs/

# Local environment / secrets
.env
app/.env
*.tmp

# OpenSSH private keys accidentally present in the working tree
21062007
21062007.pub
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# TLS / keystores / certificates
*.p12
*.pfx
*.jks
*.keystore
*.key
*.pem
*.crt
*.csr

# Certs folder contents (the directory itself stays visible so the
# non-secret generator scripts and docs below can be tracked)
certs/*
app/certs/*

# But allow the non-secret generator scripts and documentation
!certs/README.md
!certs/generate-dev-certs.ps1
!certs/generate-dev-certs.sh
!app/certs/.gitkeep
!app/certs/README.md
!app/certs/generate-dev-certs.sh

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Ignore Kotlin plugin data
.kotlin
