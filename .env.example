# Copy this file to .env (or app/.env) and replace every change-me value.
# The .env file is ignored by git; never commit real secrets.

# Database
DB_URL=jdbc:postgresql://localhost:5432/secure_chat
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT signing key: at least 32 random bytes. Generate one with:
#   powershell -Command "[Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))"
# The application will generate an ephemeral key if this is empty, but then all
# tokens become invalid after a restart.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# TLS server keystore (PKCS#12). Generate development certificates with
#   powershell -ExecutionPolicy Bypass -File certs/generate-dev-certs.ps1
TLS_KEYSTORE=certs/server-keystore.p12
TLS_KEYSTORE_PASSWORD=change-me
TLS_KEY_PASSWORD=change-me
TLS_KEY_ALIAS=server

# TCP chat port (TLS)
CHAT_TLS_PORT=5000

# HTTPS REST port
SERVER_PORT=8443

# Client-side truststore (must contain the CA that signed the server cert)
TLS_TRUSTSTORE=certs/client-truststore.p12
TLS_TRUSTSTORE_PASSWORD=change-me

# Client connection settings
CHAT_HOST=localhost
AUTH_URL=https://localhost:8443
